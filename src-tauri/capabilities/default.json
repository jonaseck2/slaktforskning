{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bun",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
