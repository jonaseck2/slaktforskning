{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Släktforskning",
  "version": "0.266.0",
  "identifier": "io.github.jonaseck2.slaktforskning",
  "build": {
    "beforeDevCommand": "node scripts/fetch-bun-binaries.mjs && npx vite --config vite.renderer.config.ts",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-bun-binaries.mjs && node scripts/build-third-party-licenses.mjs && node scripts/build-mcp-sidecar.mjs && node scripts/build-genney-sidecar.mjs && npx vite build --config vite.renderer.config.ts",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../THIRD_PARTY_LICENSES.txt",
      "../dist-mcp/server.bundle.mjs",
      "../dist-mcp/data/*",
      "../dist-genney/genney-import.bundle.mjs",
      "../dist-genney/DerbyExtractor.java"
    ],
    "externalBin": ["binaries/bun"],
    "macOS": {
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jonaseck2/slaktforskning/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQzkyRDg0NkNENjcwMjYKUldRbWNOWnNoQzNKeXlKTkR1WjE3OUR4UnVCYkZqYm5tc3JvUEVrb1d2bG1IbEg0MmtsRFBpVFIK"
    }
  }
}
