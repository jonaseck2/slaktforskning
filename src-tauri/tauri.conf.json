{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Släktforskning (Tauri)",
  "version": "0.1.0",
  "identifier": "com.slaktforskning.tauri-spike",
  "build": {
    "beforeDevCommand": "cd .. && npx vite --config vite.tauri-renderer.config.ts",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd .. && npx vite build --config vite.tauri-renderer.config.ts",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Släktforskning",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
