{
  "name": "slaktforskning",
  "productName": "Släktforskning",
  "version": "0.273.0",
  "description": "A genealogy desktop application",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:bin": "tauri build --no-bundle && node scripts/post-build-rename.mjs",
    "lint": "eslint --ext .ts,.tsx .",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build:e2e",
    "test:e2e": "playwright test --project=boot --project=crud --project=website-export --project=duplicates",
    "pretest:e2e:full": "npm run build:e2e",
    "test:e2e:full": "playwright test --project=boot --project=crud --project=website-export --project=duplicates --project=repositories --project=panels --project=reactivity --project=imports",
    "prebuild:e2e": "npm run build:static",
    "build:e2e": "tauri build --no-bundle",
    "build:static": "vite build --config vite.static.config.ts",
    "dev:static": "vite --config vite.static.config.ts",
    "build:third-party-licenses": "node scripts/build-third-party-licenses.mjs",
    "build:mcp-sidecar": "node scripts/build-mcp-sidecar.mjs",
    "build:genney-sidecar": "node scripts/build-genney-sidecar.mjs",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit --ignoreDeprecations 6.0"
  },
  "keywords": [],
  "author": {
    "name": "Jonas Ahnstedt",
    "email": "jonas.ahnstedt@imeto.se"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonaseck2/slaktforskning.git"
  },
  "homepage": "https://github.com/jonaseck2/slaktforskning",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "happy-dom": "^20.10.6",
    "mapshaper": "^0.7.48",
    "playwright": "^1.62.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/lunr": "^2.3.7",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "fflate": "^0.8.3",
    "kkrpc": "^2.0.0",
    "leaflet": "^1.9.4",
    "lunr": "^2.3.9",
    "nanotar": "^0.3.0",
    "node-sqlite3-wasm": "^0.8.60",
    "pinia": "^4.0.2",
    "uuid": "^13.0.0",
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  }
}
