{
  "name": "Släktforskning",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached"
  ],

  "postCreateCommand": "npm install && ensure-native-binaries && npx playwright install chromium && bash .devcontainer/check-claude-skills.sh || true",
  "postStartCommand": "bash .devcontainer/xvfb-start.sh",

  // Environment variable so E2E tests know to use a temp DB path
  "remoteEnv": {
    "DISPLAY": ":99"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "ms-playwright.playwright",
        "anthropic.claude-code"
      ],
      "settings": {
        "js/ts.tsdk.path": "node_modules/typescript/lib",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      }
    }
  },

  // Forward the MCP server port if run as HTTP in future; 9229 for Node debugger
  "forwardPorts": [9229]
}
