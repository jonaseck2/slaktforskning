{
  "name": "Släktforskning",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "mounts": [
    "source=claude-credentials,target=/home/node/.claude,type=volume"
  ],

  "remoteUser": "node",
  "postCreateCommand": "sudo chown -R node:node ~/.claude 2>/dev/null || true && npm install --legacy-peer-deps && ensure-native-binaries && npx playwright install chromium && bash .devcontainer/setup-signing.sh",
  "postStartCommand": "bash .devcontainer/xvfb-start.sh",

  "remoteEnv": {
    "DISPLAY": ":99",
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "GITHUB_PERSONAL_ACCESS_TOKEN": "${localEnv:GITHUB_PERSONAL_ACCESS_TOKEN}",
    "GIT_SIGNING_KEY": "${localEnv:GIT_SIGNING_KEY}",
    "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "ms-playwright.playwright",
        "anthropic.claude-code"
      ],
      "settings": {
        "js/ts.tsdk.path": "node_modules/typescript/lib",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      }
    }
  },

  // 9222 = Electron CDP (Chrome DevTools Protocol), connectable from host browser
  // 19241 = UI bridge server (used by MCP dev tools and verify-cdp.sh)
  // 9229 = Node.js debugger
  "forwardPorts": [9222, 19241, 9229]
}
