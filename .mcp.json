{
  "mcpServers": {
    "slaktforskning": {
      "command": "npx",
      "args": [
        "tsx",
        "src/mcp/server.ts"
      ],
      "cwd": ".",
      "env": {
        "SLAKTFORSKNING_DB_PATH": "/Users/jonasahnstedt/Library/Application Support/com.slaktforskning.tauri-spike/family.db"
      }
    },
    "slaktforskning-dev": {
      "command": "npx",
      "args": [
        "tsx",
        "src/mcp/devServer.ts"
      ],
      "cwd": ".",
      "env": {
        "SLAKTFORSKNING_DB_PATH": "/Users/jonasahnstedt/Library/Application Support/com.slaktforskning.tauri-spike/family.db",
        "SLAKTFORSKNING_UI_PORT": "19241"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}