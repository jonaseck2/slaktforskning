{
  "mcpServers": {
    "slaktforskning": {
      "command": "npx",
      "args": [
        "tsx",
        "src/mcp/server.ts"
      ],
      "cwd": "."
    },
    "slaktforskning-dev": {
      "command": "npx",
      "args": [
        "tsx",
        "src/mcp/devServer.ts"
      ],
      "cwd": "."
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}