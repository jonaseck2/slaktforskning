{
  "mcpServers": {
    "slaktforskning": {
      "command": "node",
      "args": [
        "scripts/mcp-tauri.mjs",
        "prod"
      ],
      "cwd": "."
    },
    "slaktforskning-dev": {
      "command": "node",
      "args": [
        "scripts/mcp-tauri.mjs",
        "dev"
      ],
      "cwd": ".",
      "env": {
        "SLAKTFORSKNING_UI_PORT": "19241"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
